{
  "name": "workout-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run cap:sync && npx cap run android",
    "postinstall": "mkdir -p public/assets && cp -u node_modules/sql.js/dist/sql-wasm.wasm public/assets/sql-wasm.wasm"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.6.5",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.6.5",
    "@capacitor/network": "^7.0.2",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "jeep-sqlite": "^2.8.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^11.0.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
